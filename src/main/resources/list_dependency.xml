<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="b1" class="dependency_injection.Book">
        <property name="id" value="101"/>
        <property name="name" value="Java Programming"/>
    </bean>

    <bean id="b2" class="dependency_injection.Book">
        <property name="id" value="102"/>
        <property name="name" value="Spring Framework"/>
    </bean>

    <bean id="b3" class="dependency_injection.Book">
        <property name="id" value="103"/>
        <property name="name" value="Data Structures"/>
    </bean>

    <bean id="library1" class="dependency_injection.Library1">
        <property name="id" value="1"/>
        <property name="name" value="Central Library"/>

        <property name="books">
            <list>
                <ref bean="b1"/>
                <ref bean="b2"/>
                <ref bean="b3"/>
            </list>
        </property>
    </bean>

</beans>